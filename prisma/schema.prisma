generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model IdentityDocumentType {
  id           BigInt  @id @default(autoincrement())
  abbreviation String  @unique 
  description  String? 
  
  people Person[]
}

model Person {
  id                       String    @id @default(ulid()) @db.Uuid
  identityDocumentTypeId   BigInt    
  identityDocumentNumber   String    
  givenNames               String    
  paternalSurname          String    
  maternalSurname          String    
  birthDate                DateTime? 
  birthPlace               String?   
  father                   String?   
  mother                   String?   

  identityDocumentType IdentityDocumentType @relation(fields: [identityDocumentTypeId], references: [id])

  @@unique([identityDocumentTypeId, identityDocumentNumber])
}
