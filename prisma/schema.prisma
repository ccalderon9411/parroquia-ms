generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TipoDocumentIdentidad {
  id                BigInt @id @default(autoincrement())
  abreviatura       String @unique
  descripcion       String?


  personas     Persona[]
}

model Persona {
  id                         String @id @default(ulid()) @db.Uuid
  tipoDocumentoIdentidadId   BigInt
  numeroDocumentoIdentidad   String
  nombres                    String
  apellidoPaterno            String
  apellidoMaterno            String
  fechaNacimiento            DateTime?
  lugarNacimiento            String?
  padre                      String?
  madre                      String?

  // Relaciones
  tipoDocumentoIdentidad TipoDocumentIdentidad @relation(fields: [tipoDocumentoIdentidadId], references: [id])
  @@unique([tipoDocumentoIdentidadId, numeroDocumentoIdentidad])
}
